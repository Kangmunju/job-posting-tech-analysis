간)휴가\n  ⑤ 명절/출산/자녀입학 선물 지급\n  ⑥ 사내카페/힐링존(안마의자) 운영\n  ⑦ 기 타 : 도서 할인, 휴양시설 할인 이용, 온라인 강의 수강 지원, 자격증 취득 지원 등", "preferred_points": "• (우대) RAG 경험자\n• (우대) 오픈소스 기반 BI툴을 활용한 데이터분석/시각화 경험자"}, "due_time": null, "score": null, "company_images": [{"url": "https://static.wanted.co.kr/images/company/5874/os0upoby1xnoa9ft__1080_790.jpg", "id": 14792}, {"url": "https://static.wanted.co.kr/images/company/5874/7otze07l7aiu8cis__1080_790.jpg", "id": 14793}, {"url": "https://static.wanted.co.kr/images/company/5874/7j5ajtsfo8r4accl__1080_790.jpg", "id": 14794}, {"url": "https://static.wanted.co.kr/images/company/5874/emuj5abpa0dzykue__1080_790.jpg", "id": 14795}, {"url": "https://static.wanted.co.kr/images/company/5874/gmfbcuvam1xcrfhb__1080_790.jpg", "id": 14796}, {"url": "https://static.wanted.co.kr/images/company/5874/gzoagbrwjqoqr0ci__1080_790.jpg", "id": 14797}], "hidden": false, "skill_tags": [{"title": "MySQL", "id": 1464, "kind_title": "SKILL"}, {"title": "Java", "id": 1540, "kind_title": "SKILL"}, {"title": "JavaScript", "id": 1541, "kind_title": "SKILL"}, {"title": "REST", "id": 1849, "kind_title": "SKILL"}, {"title": "Spring Framework", "id": 3078, "kind_title": "SKILL"}, {"title": "MSSQL", "id": 10167, "kind_title": "SKILL"}], "status": "active", "is_bookmark": false, "company": {"id": 5874, "industry_name": "교육", "application_response_stats": {"avg_rate": 81.82, "level": "normal", "delayed_count": 0, "avg_day": null, "remained_count": 0, "type": "applied_reply_done"}, "name": "미래엔"}, "has_analysis": false, "is_company_follow": false, "compare_country": true, "logo_img": {"origin": "https://static.wanted.co.kr/images/wdes/0_4.e6f1e3c7.jpg", "thumb": "https://static.wanted.co.kr/images/wdes/0_5.e6f1e3c7.jpg"}, "address": {"country": "한국", "full_location": "서초구 신반포로 321", "geo_location": {"n_location": {"lat": 37.5107291, "lng": 127.0187971, "address": "서울특별시 서초구 신반포로 321 미래엔"}, "location": {"lat": 37.5106858, "lng": 127.0187644}, "location_type": "ROOFTOP", "viewport": {"n